# ---------------------------
# Unity project essentials
# ---------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
# Burst / IL2CPP / Caches
[Bb]ee/
[Aa]rtifacts/
*.il2cpp_cache/
*.unity_wip
*.niproj
*.nrbak

# Visual Scripting (Bolt/UVS) caches
Assets/UnityVSGenerated/
Assets/Plugins/Editor/NodeCanvas/.*

# Addressables (keep config, ignore local cache)
# (The AddressableAssetsData folder itself should be versioned; cache lives in Library.)
# If you export content state files outside default location, add ignores here.

# ---------------------------
# IDE / Editor cruft
# ---------------------------
# Visual Studio / Rider
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.sln.iml

# VSCode: usually keep workspace settings you intentionally share.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Autogenerated C# project files (Unity regenerates these)
*.csproj
*.unityproj
*.sln
*.vcxproj
*.vcxproj.filters
*.pidb
*.svd

# Debug / profiling
*.pdb
*.mdb
*.opendb
*.VC.db
*.orig
*.Diff

# ---------------------------
# OS junk
# ---------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
desktop.ini

# Linux
*~

# ---------------------------
# Build outputs / exports
# ---------------------------
*.apk
*.aab
*.ipa
*.app
*.xcodeproj
*.xcworkspace
*.xcuserstate
*.xcuserdata
DerivedData/
Pods/

# ---------------------------
# Unity Package Manager cache (keep manifest & lockfile tracked)
# ---------------------------
# (Do NOT ignore Packages/ or ProjectSettings/)
# (packages-lock.json should be committed)
# Packages/ is intentionally NOT ignored

# ---------------------------
# Crash dumps
# ---------------------------
*.dmp

# ---------------------------
# TextMesh Pro generated (safe to regenerate)
# ---------------------------
Assets/TextMesh Pro/Resources/Font Asset Creator Settings.asset

# ---------------------------
# Collaborate/Plastic leftovers (if you ever used them)
# ---------------------------
.collabignore
.plastic/
.gluon/

# ---------------------------
# Optional: Git LFS recommendations (uncomment if you use LFS)
# ---------------------------
# Large binary assets benefit from LFS:
# *.psd filter=lfs diff=lfs merge=lfs -text
# *.png filter=lfs diff=lfs merge=lfs -text
# *.jpg filter=lfs diff=lfs merge=lfs -text
# *.tga filter=lfs diff=lfs merge=lfs -text
# *.wav filter=lfs diff=lfs merge=lfs -text
# *.mp3 filter=lfs diff=lfs merge=lfs -text
# *.fbx filter=lfs diff=lfs merge=lfs -text
# *.blend filter=lfs diff=lfs merge=lfs -text
# *.obj filter=lfs diff=lfs merge=lfs -text
# *.prefab filter=lfs diff=lfs merge=lfs -text
# *.unity filter=lfs diff=lfs merge=lfs -text

# ---------------------------
# Notes
# ---------------------------
# - Keep *.meta files tracked (crucial for Unity asset references).
# - Keep Assets/, ProjectSettings/, and Packages/ in Git.
# - Consider committing .vscode/*.json if you want shared debug/task configs.
