  _id: 14201202
  _key: DIALOGUE_NODE_SIR_ALDRIC_IDENTITY
  _displayName: Identity
  _description: Aldric introduces himself and explains the oath he has sworn.
  _speakerName: Sir Aldric
  _dialogueText: 'Sir Aldric. Once a knight sworn to guard the ancient sanctuaries.
    Now, as you can plainly see, a prisoner.

    My title means little within these
    walls. My oath, however, remains.'
  _choices:
  - _choiceText: Tell me about your oath.
    _requirements: []
    _actions: []
    _nextNode: {fileID: 11400000, guid: 6c54af0a52ddb3444a1c7f42092d76a3, type: 2}
  - _choiceText: Who imprisoned you?
    _requirements: []
    _actions: []
    _nextNode: {fileID: 11400000, guid: 4192fd3d9ec0ed6478b9e830c844dd64, type: 2}
  - _choiceText: I understand.
    _requirements: []
