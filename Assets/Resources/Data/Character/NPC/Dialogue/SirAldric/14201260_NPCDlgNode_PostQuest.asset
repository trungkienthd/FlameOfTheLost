  _id: 14201260
  _key: DIALOGUE_NODE_SIR_ALDRIC_POST_QUEST
  _displayName: Post Quest
  _description: Main repeatable dialogue after An Oath Unbroken has been completed.
  _speakerName: Sir Aldric
  _dialogueText: 'Ah, my friend. It is good to see you again.

    Strange, is it
    not? I once thought these halls would be my tomb. Now I find a measure of peace
    within them.

    There is no need to rush. Stay a while, if you like.'
  _choices:
  - _choiceText: How have you been?
    _requirements: []
    _actions: []
    _nextNode: {fileID: 11400000, guid: 3b25a6d9c8c0f2840af5ce47ac39b12a, type: 2}
  - _choiceText: Perhaps another time.
    _requirements: []
    _actions: []
    _nextNode: {fileID: 0}
