  m_Name: 14201242_NPCDlgNode_StayForAWhile
  m_EditorClassIdentifier: Assembly-CSharp::FlameOfTheLost.NPCDialogueNodeData
  _id: 14201242
  _key: DIALOGUE_NODE_SIR_ALDRIC_STAY_FOR_A_WHILE
  _displayName: Stay for a while
  _description: After his quest concludes, Aldric chooses to remain in the Sanctum
    and welcomes the Player to spend more time with him. Future entry point for skill
    training.
  _speakerName: Sir Aldric
  _dialogueSegments:
  - I believe I shall remain here for a while.
  - These halls have known suffering for far too long. Perhaps, in time, they may
    become a place of peace once more.
  - And you, my friend... you need not hurry away.
  - Stay for a while, if you wish. There is still much we might learn from one another.
  _dialogueText: 'I believe I shall remain here for a while.

    These halls have
    known suffering for far too long. Perhaps, in time, they may become a place of
    peace once more.

    And you, my friend... you need not hurry away.

    Stay
    for a while, if you wish. There is still much we might learn from one another.'
  _choices:
  - _choiceText: I may take you up on that.
    _requirements: []
    _actions: []
    _nextNode: {fileID: 0}
  - _choiceText: I must continue my journey.
    _requirements: []
    _actions: []
    _nextNode: {fileID: 0}
